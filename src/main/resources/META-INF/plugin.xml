<idea-plugin>
    <id>io.github.mybatisbridge</id>
    <name>MyBatis Bridge</name>
    <vendor>Yimeng</vendor>
    <icon>pluginIcon.svg</icon>
    <description><![CDATA[
        <p>Free navigation between MyBatis mapper interfaces and XML statements.</p>
    ]]></description>

    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider language="JAVA" implementationClass="io.github.mybatisbridge.navigation.JavaMapperLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="XML" implementationClass="io.github.mybatisbridge.navigation.XmlMapperLineMarkerProvider"/>
    </extensions>
</idea-plugin>
